APP_NAME=Eureka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eureka
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Emails are written to storage/logs/laravel.log until Fabtech IT sets up the sender.
# To send for real, switch MAIL_MAILER to smtp and fill in the SMTP details.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="eureka@fabtech.example"
MAIL_FROM_NAME="Eureka"

# Office rules
EUREKA_OPEN=08:00
EUREKA_CLOSE=20:00
EUREKA_CHECKIN_REMINDER_MINUTES=10
EUREKA_AUTO_RELEASE_MINUTES=10
EUREKA_MAX_REPEAT_WEEKS=12
EUREKA_BOOK_AHEAD_DAYS=60
